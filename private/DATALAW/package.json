{
  "name": "Dorlane",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "ensure-protoc": "powershell -ExecutionPolicy Bypass -File ./tools/install-protoc.ps1",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-tests.ts",
    "lint": "node tools/lint.mjs",
    "check:translations": "node tools/validateTranslations.mjs",
    "release:notes": "node tools/generateReleaseNotes.mjs",
    "ci:validate": "pnpm typecheck && pnpm test && pnpm lint && pnpm check:translations && pnpm build",
    "format": "prettier --write .",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.0",
    "react": "^19.1.0",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.25.1",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
