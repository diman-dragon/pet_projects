{
  "name": "folio-datalaw",
  "version": "0.2.5",
  "private": true,
  "description": "Folio - universal document viewer for Android (Capacitor). PDF first.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs && node scripts/fetch-ocr.mjs",
    "dev": "node scripts/dev-server.mjs",
    "check": "node scripts/check.mjs",
    "bump": "node scripts/bump-version.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "sync": "node scripts/sync-version.mjs && node scripts/copy-vendor.mjs && node scripts/fetch-ocr.mjs && cap sync android",
    "open": "cap open android",
    "fetch-ocr": "node scripts/fetch-ocr.mjs --force"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
